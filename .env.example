# This project never inherits credentials from any existing project.
# Supply only keys that belong to NEW Reelbrain infrastructure.
REELBRAIN_DB=data/reelbrain_local.db
REELBRAIN_TENANT=personal
# For opt-in transcriptions, not needed for offline baseline:
GROQ_API_KEY=
