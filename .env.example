# Future optional providers - model names must be validated against current docs:
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=
GEMINI_DEEP_MODEL=
EMBED_MODEL=
# For a NEW Supabase project only, never reuse GTA VI or any existing database.
NEW_REELBRAIN_SUPABASE_PROJECT_REF=
NEW_REELBRAIN_POSTGRES_URL=

# Phase 7: private web-share UI. Never commit a real token.
REELBRAIN_API_TOKEN=
