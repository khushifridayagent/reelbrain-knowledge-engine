# Production-capable *separate* video worker (not a free always-on guarantee).
# Deploy only to NEW Reelbrain service/host; never attach to unrelated projects.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ffmpeg tesseract-ocr tesseract-ocr-eng tesseract-ocr-hin ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml requirements-worker.txt ./
COPY reelbrain/ ./reelbrain/
RUN pip install --no-cache-dir -r requirements-worker.txt
RUN useradd --uid 10001 --create-home reelbrain && mkdir -p /app/data && chown -R reelbrain:reelbrain /app/data
USER reelbrain
CMD ["python", "-m", "reelbrain.durable_worker"]